# Set environment variables in your shell; this file is a documented example, not loaded automatically.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Required when DJANGO_DEBUG=0; use a long random value outside source control.
# DJANGO_SECRET_KEY=
# Production requires PostgreSQL. SQLite is only the local development default.
# DATABASE_URL=postgresql://rc_property:password@localhost:5432/rc_property
# Inquiry forms are preview-only; real collection is a later implementation milestone.
# Trust forwarded HTTPS headers only behind your configured trusted ingress.
TRUST_PROXY_HTTPS=0
